<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RAINY PC Health" Width="1180" Height="810" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#0C1220" Foreground="#EDF2FC" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9BAAC2"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DAE4F5"/><Setter Property="Background" Value="#1C293D"/><Setter Property="BorderBrush" Value="#2D3C53"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#6DE3C3"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="#A9B8D0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101A2A"/><Setter Property="Foreground" Value="#E1EAF8"/><Setter Property="CaretBrush" Value="#6DE3C3"/><Setter Property="BorderBrush" Value="#314159"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#203048"/><Setter Property="Foreground" Value="#EDF2FC"/></Style>

  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="#101A2A"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}" Width="7"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#41536D" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="HeaderButton" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Left" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" Cursor="Hand"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="›" FontSize="15" Margin="0,0,7,0" Foreground="{TemplateBinding Foreground}"/><TextBlock Text="Дэлгэрэнгүй" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#AAFFE2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#0C1220" BorderBrush="#2A3850" BorderThickness="1" CornerRadius="12">
 <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#101827" CornerRadius="12,12,0,0"><Grid Margin="16,0,8,0"><TextBlock Text="RAINY  /  PC HEALTH" Foreground="#8E9FB9" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Content="—" Width="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Цонх буулгах"/><Button x:Name="MaximizeButton" Content="□" Width="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Цонх томруулах"/><Button x:Name="CloseButton" Content="✕" Width="40" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Хаах"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#101827" BorderBrush="#233047" BorderThickness="0,0,1,0"><DockPanel Margin="18,24,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28"><StackPanel Orientation="Horizontal"><Image x:Name="BrandIcon" Width="40" Height="40" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="RAINY" FontSize="23" FontWeight="Bold"/><TextBlock Text="PC HEALTH" FontSize="10" Foreground="#6DE3C3"/></StackPanel></StackPanel><Border Background="#16352F" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left" Margin="0,17,0,0"><TextBlock Text="ҮНЭГҮЙ · PORTABLE" Foreground="#77DFC4" FontSize="10" FontWeight="SemiBold"/></Border></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="#172438" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="Тусламж хэрэгтэй юу?" FontWeight="SemiBold"/><TextBlock Text="Засвар, driver, лиценз,&#10;програм суулгалт." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,13" LineHeight="18"/><Button x:Name="TelegramSide" Content="Telegram  ↗" Background="#21483F" BorderBrush="#326459" Foreground="#8AE8CF" Padding="10,9"/><Button x:Name="FacebookSide" Content="Facebook  ↗" Margin="0,7,0,0" Padding="10,9"/></StackPanel></Border><TextBlock Text="v1.0 · Windows 10 / 11" FontSize="10" Foreground="#71839E" Margin="4,18,0,0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="ТАНЫ КОМПЬЮТЕР" FontSize="10" Foreground="#6F839F" Margin="12,0,0,10"/>
     <Button x:Name="NavAll" Tag="all" Style="{StaticResource Nav}" AutomationProperties.Name="Ерөнхий төлөв"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="24" VerticalAlignment="Center"/><TextBlock Text="Ерөнхий төлөв"/></StackPanel></Button>
     <Button x:Name="NavHardware" Tag="hardware" Style="{StaticResource Nav}" AutomationProperties.Name="Төхөөрөмж"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Width="24" VerticalAlignment="Center"/><TextBlock Text="Төхөөрөмж"/></StackPanel></Button>
     <Button x:Name="NavDrivers" Tag="drivers" Style="{StaticResource Nav}" AutomationProperties.Name="Driver"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Width="24" VerticalAlignment="Center"/><TextBlock Text="Driver"/></StackPanel></Button>
     <Button x:Name="NavLicense" Tag="license" Style="{StaticResource Nav}" AutomationProperties.Name="Лиценз"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;" Width="24" VerticalAlignment="Center"/><TextBlock Text="Лиценз"/></StackPanel></Button>
     <Button x:Name="NavSecurity" Tag="security" Style="{StaticResource Nav}" AutomationProperties.Name="Хамгаалалт"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA18;" Width="24" VerticalAlignment="Center"/><TextBlock Text="Хамгаалалт"/></StackPanel></Button>
     <Button x:Name="NavSystem" Tag="system" Style="{StaticResource Nav}" AutomationProperties.Name="Windows"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE782;" Width="24" VerticalAlignment="Center"/><TextBlock Text="Windows"/></StackPanel></Button>
     <Button x:Name="NavApps" Tag="apps" Style="{StaticResource Nav}" AutomationProperties.Name="Програмууд"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Width="24" VerticalAlignment="Center"/><TextBlock Text="Програмууд"/></StackPanel></Button>
    </StackPanel></ScrollViewer>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="28,21,28,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,17"><StackPanel><TextBlock Text="КОМПЬЮТЕРЭЭ ИЛҮҮ САЙН МЭДЬЕ" FontSize="10" Foreground="#6DE3C3" FontWeight="SemiBold"/><TextBlock Text="Таны компьютер ямар байна?" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button x:Name="ExportButton" Content="Тайлан хадгалах  ↓" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False" ToolTip="HTML эсвэл JSON тайлан хадгална"/></Grid>
    <Border Grid.Row="1" BorderBrush="#2B4C4A" BorderThickness="1" CornerRadius="15" Padding="21,17" Margin="0,0,0,16"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#183833" Offset="0"/><GradientStop Color="#162336" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock x:Name="HeroTitle" Text="Нэг товч. Бодит мэдээлэл." FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="HeroSubtitle" Text="Төхөөрөмж, driver, лиценз, хамгаалалтаа шалгаарай." Foreground="#BDD1D3" TextWrapping="Wrap" Margin="0,7,0,10"/><TextBlock Text="Зөвхөн мэдээлэл уншина · Сервер рүү илгээхгүй" Foreground="#87B3A9" FontSize="11"/><ProgressBar x:Name="ScanProgress" Minimum="0" Maximum="100" Value="0" Height="3" Margin="0,13,0,0" Foreground="#70E0C0" Background="#2A4547" BorderThickness="0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="Шалгалт эхлүүлэх  →" Background="#77E0C1" Foreground="#0C2823" BorderBrush="#A0EED7" Padding="14,12"/><Button x:Name="CancelButton" Content="Зогсоох" Margin="0,6,0,0" Visibility="Collapsed"/><TextBlock x:Name="ScanStatus" Text="Суулгалт шаардлагагүй" FontSize="10" Foreground="#9CB7BA" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Grid>
    </Border>
    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,-10,16">
     <Border Background="#151F30" CornerRadius="11" Padding="15,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="ШАЛГАСАН ҮЗҮҮЛЭЛТ" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
     <Border Background="#151F30" CornerRadius="11" Padding="15,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="ХЭВИЙН" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OkCount" Text="—" FontSize="28" Foreground="#77E0C1" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
     <Border Background="#151F30" CornerRadius="11" Padding="15,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="АНХААРАХ" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IssueCount" Text="—" FontSize="28" Foreground="#F4C175" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
     <Border Background="#151F30" CornerRadius="11" Padding="15,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="ТОДОРХОЙГҮЙ" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UnknownCount" Text="—" FontSize="28" Foreground="#B9ACED" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultsTitle" Text="Шалгалтын үр дүн" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="IssuesOnly" Grid.Column="1" Content="Анхаарах" Foreground="#BCCADF" VerticalAlignment="Center" Margin="0,0,16,0"/><Grid Grid.Column="2"><TextBox x:Name="SearchBox" ToolTip="Нэр, төлөв, дэлгэрэнгүй мэдээллээр хайх" AutomationProperties.Name="Үр дүнгээс хайх"/><TextBlock Text="Үр дүнгээс хайх…" Foreground="#7187A4" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
    <Grid Grid.Row="4">
     <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ResultList"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#141F30" BorderBrush="#243249" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,4,9"><StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0"/><TextBlock Grid.Column="1" Text="{Binding Badge}" Foreground="{Binding Accent}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/></Grid>
       <TextBlock Text="{Binding Summary}" Foreground="#A9BBD2" Margin="0,5,0,0" TextWrapping="Wrap"/>
       <Expander Header="Дэлгэрэнгүй" Foreground="#83B8AF" FontSize="11" Margin="0,8,0,0"><TextBlock Text="{Binding Detail}" Foreground="#A5B5CC" TextWrapping="Wrap" Margin="4,7,4,3" LineHeight="18"/></Expander>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <Border x:Name="EmptyState" Background="#111B2B" CornerRadius="12" BorderBrush="#25334A" BorderThickness="1"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock Text="◎" Foreground="#6DE3C3" FontSize="42" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="Таны тайлан энд харагдана" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock x:Name="EmptyText" Text="Шалгалт эхлүүлэх товчийг дарна уу.&#10;Тохиргоо өөрчлөхгүй, програм устгахгүй." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,8,0,0" LineHeight="21"/></StackPanel></Border>
    </Grid>
    <StackPanel Grid.Row="5" Margin="0,13,0,0"><TextBlock x:Name="ConclusionText" Text="Оношилгооны дүгнэлт шалгалтын дараа гарна." Foreground="#94A7C3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/><Grid><StackPanel Orientation="Horizontal"><Button x:Name="SecurityButton" Content="Вирус шалгах  ↗" FontSize="11" Padding="11,8" ToolTip="Windows Security нээнэ; сканыг та эхлүүлнэ"/><Button x:Name="UpdateButton" Content="Windows Update  ↗" FontSize="11" Padding="11,8" Margin="7,0,0,0"/><Button x:Name="CopyButton" Content="Дүгнэлт хуулах" FontSize="11" Padding="11,8" Margin="7,0,0,0" IsEnabled="False"/></StackPanel><TextBlock Text="LOCAL &amp; PRIVATE" FontSize="9" Foreground="#627A98" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>
